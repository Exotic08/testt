#
# Claudex Agentic Workspace - cấu hình môi trường
# Copy file này thành .env rồi điền giá trị thật. Không commit file .env.
#

# ---------- AI provider ----------
# API key của provider (bắt buộc để chat)
AI_API_KEY=your_api_key_here
# Base URL kiểu OpenAI-compatible
AI_BASE_URL=https://api.openai.com/v1
# Tên model gửi lên provider
AI_MODEL=claudex-3-5-sonnet-20241022

# ---------- Máy chủ web ----------
# Cổng server lắng nghe (Pterodactyl thường dùng 3000 hoặc giá trị SERVER_PORT của egg)
SERVER_PORT=3000
# Host lắng nghe, giữ 0.0.0.0 trong container
SERVER_HOST=0.0.0.0
# Mật khẩu bảo vệ giao diện (để trống = không yêu cầu)
WORKSPACE_PASSWORD=

# ---------- start.js (tự cập nhật khi restart) ----------
# Repo nguồn để tải code về
GIT_REPO_URL=https://github.com/Exotic08/testt.git
# Nhánh cần theo dõi
GIT_BRANCH=main
# 1 = mỗi lần restart tự fetch/cập nhật, 0 = tắt cập nhật
AUTO_UPDATE=1
# 1 = xoá code cũ và cài đúng bản repo (chỉ giữ PRESERVE_PATHS), 0 = giữ file cũ
CLEAN_INSTALL=1
# Các mục luôn giữ lại khi clean install (phân tách bằng dấu phẩy)
PRESERVE_PATHS=.env,.agent,node_modules,skills
# auto = chỉ cài khi thiếu/hỏng, always = luôn npm install, never = không cài
NPM_INSTALL=auto
# File khởi chạy sau khi cập nhật
START_ENTRY=server.js
# Ghi log của start.js ra file (để trống = chỉ in ra console)
START_LOG_FILE=

# Repo private: điền GitHub token có scope "repo" (đừng commit token này)
# GITHUB_TOKEN=
